{
  "repositoryName": "slicify-v3-aymen",
  "libraries": [
    "./slices/marketing",
    "./slices/blog"
  ],
  "routes": [
    {
      "type": "home_page",
      "path": "/:lang/"
    },
    {
      "type": "blog_index",
      "path": "/:lang/blog"
    },
    {
      "type": "blog_article",
      "path": "/:lang/blog/:category?/:uid",
      "resolvers": {
        "category": "category"
      }
    },
    {
      "type": "landing_page",
      "path": "/:lang/lp/:uid"
    },
    {
      "type": "search",
      "path": "/:lang/search"
    }
  ]
}